# Frontend (Next.js inlines NEXT_PUBLIC_* at build time)
# Leave empty when the Rust server serves ./out on the same origin.
NEXT_PUBLIC_API_BASE_URL=

# Backend
HOST=0.0.0.0
PORT=8080
STATIC_DIR=./out
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
TRUST_PROXY=false
USER_AGENT=TerraData/2.0 (+https://github.com/EvertuN/terradata)
REQUEST_TIMEOUT_MS=8000
CONNECT_TIMEOUT_MS=4000
UPSTREAM_CONCURRENCY=24
PER_IP_BURST=30
PER_IP_PER_MINUTE=180
# Enable GeoDB for real nearby cities outside Brazil (optional).
ENABLE_GEODB=false
RUST_LOG=terradata_api=info,tower_http=info
