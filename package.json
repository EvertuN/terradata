{
  "name": "terradata",
  "version": "2.0.0",
  "description": "TerraData - Agregador Geográfico e Meteorológico com backend Rust e frontend Next.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "next dev -p 3000",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "cargo build --release --manifest-path backend/Cargo.toml",
    "start": "cargo run --release --manifest-path backend/Cargo.toml",
    "preview": "npm run build && npm start",
    "test:api": "cargo test --manifest-path backend/Cargo.toml",
    "export:cities": "node scripts/export_cities.js"
  },
  "dependencies": {
    "chart.js": "^4.4.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-native-web": "^0.19.3",
    "typescript": "^5.6.3"
  }
}
